    {
      "id": "b:witlofschotel-uit-de-oven",
      "name": {
        "nl": "Witlofschotel uit de oven"
      },
      "servings": 4,
      "lines": [
        {
          "i": 0,
          "raw": "500 g witlof",
          "parsed": {
            "qty": {
              "min": 500
            },
            "unit": "g",
            "ing": "witlof",
            "qual": [],
            "prep": null,
            "name": "witlof"
          }
        },
        {
          "i": 1,
          "raw": "200 g geraspte kaas",
          "parsed": {
            "qty": {
              "min": 200
            },
            "unit": "g",
            "ing": "kaas",
            "qual": [
              "geraspte"
            ],
            "prep": null,
            "name": "kaas"
          }
        },
        {
          "i": 2,
          "raw": "200 g achterham in plakken",
          "parsed": {
            "qty": {
              "min": 200
            },
            "unit": "g",
            "ing": "ham",
            "qual": [],
            "prep": null,
            "name": "achterham in plakken"
          }
        },
        {
          "i": 3,
          "raw": "30 g boter",
          "parsed": {
            "qty": {
              "min": 30
            },
            "unit": "g",
            "ing": "boter",
            "qual": [],
            "prep": null,
            "name": "boter"
          }
        },
        {
          "i": 4,
          "raw": "30 g bloem",
          "parsed": {
            "qty": {
              "min": 30
            },
            "unit": "g",
            "ing": "bloem",
            "qual": [],
            "prep": null,
            "name": "bloem"
          }
        },
        {
          "i": 5,
          "raw": "300 ml melk",
          "parsed": {
            "qty": {
              "min": 300
            },
            "unit": "ml",
            "ing": "melk",
            "qual": [],
            "prep": null,
            "name": "melk"
          }
        }
      ],
      "steps": [
        {
          "nl": "Halveer de witlof en snijd de bittere kern eruit. De witlof ongeveer 5 minuten koken in water met zout. Laat de witlof uitlekken in een vergiet en een beetje afkoelen. Wikkel elk half witlofje in een plakje achterham en leg ze naast elkaar in een ovenschaal."
        },
        {
          "nl": "Kaassaus: Smelt 30 g boter in een steelpannetje en voeg 30 g bloem toe en daarna scheutje voor scheutje melk erbij doen en na elk scheutje aan de kook brengen, tot er een fijn sausje ontstaat."
        },
        {
          "nl": "Voeg dan 150 g van de kaas toe, witte peper en zout naar smaak. Giet de saus over de ingepakte witlof in de ovenschaal en strooi de rest van de geraspte kaas en eventueel wat paneermeel erover."
        },
        {
          "nl": "Zet de schaal 20 tot 30 minuten in de oven op 200 °C, totdat de kaas gesmolten en een beetje bruin is."
        }
      ]
    },
