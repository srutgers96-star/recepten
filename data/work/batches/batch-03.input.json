    {
      "id": "b:couscous-met-runderreepjes",
      "name": {
        "nl": "Couscous met runderreepjes"
      },
      "servings": 4,
      "lines": [
        {
          "i": 0,
          "raw": "1 pak couscous",
          "parsed": {
            "qty": {
              "min": 1
            },
            "unit": "pak",
            "ing": "couscous",
            "qual": [],
            "prep": null,
            "name": "couscous"
          }
        },
        {
          "i": 1,
          "raw": "1 scheutje olijfolie",
          "parsed": {
            "qty": {
              "min": 1
            },
            "unit": "scheut",
            "ing": "olijfolie",
            "qual": [],
            "prep": null,
            "name": "olijfolie"
          }
        },
        {
          "i": 2,
          "raw": "250 g runderreepjes",
          "parsed": {
            "qty": {
              "min": 250
            },
            "unit": "g",
            "ing": "runderreepjes",
            "qual": [],
            "prep": null,
            "name": "runderreepjes"
          }
        },
        {
          "i": 3,
          "raw": "3 sjalotjes [ringen]",
          "parsed": {
            "qty": {
              "min": 3
            },
            "unit": null,
            "ing": "sjalot",
            "qual": [],
            "prep": {
              "nl": "ringen"
            },
            "name": "sjalotjes"
          }
        },
        {
          "i": 4,
          "raw": "1 groene paprika [dunne reepjes]",
          "parsed": {
            "qty": {
              "min": 1
            },
            "unit": null,
            "ing": "paprika",
            "qual": [
              "groene"
            ],
            "prep": {
              "nl": "dunne reepjes"
            },
            "name": "paprika"
          }
        },
        {
          "i": 5,
          "raw": "50 g cashewnoten",
          "parsed": {
            "qty": {
              "min": 50
            },
            "unit": "g",
            "ing": "cashewnoot",
            "qual": [],
            "prep": null,
            "name": "cashewnoten"
          }
        }
      ],
      "steps": [
        {
          "nl": "Verhit de olijfolie in een koekenpan en bak hierin de runderreepjes in ca. 4 minuten goudbruin en gaar. Voeg de sjalotjes en paprika toe en bak deze ca. 5 minuten op middelhoog vuur mee tot de paprika beetgaar is."
        },
        {
          "nl": "Doe ondertussen de couscous in een kom. Schenk 425 ml kokend water over de couscous en laat deze ca. 5 minuten wellen. Roer de couscous een keer goed door."
        },
        {
          "nl": "Breng de runderreepjes op smaak met zout en peper. Doe de couscous en de cashewnoten bij de runderreepjes met paprika en sjalotjes en roer een keer door."
        }
      ]
    },
