{
  "name": "rutgers-recepten",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Rutgers' Recepten — bilingual family cookbook PWA (NL/EN), WhatsApp sharing, weekly shopping list.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:next": "cross-env NEXT_CHANNEL=1 vite build --base=/recepten/next/ --outDir dist-next",
    "preview": "vite preview --host",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node --experimental-strip-types tools/validate-data.ts",
    "migrate": "node --experimental-strip-types tools/migrate-from-recepten2.ts",
    "measure-parse": "node --experimental-strip-types tools/measure-parse.ts",
    "icons": "python tools/make-icons.py"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "preact": "^10.29.8",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "cross-env": "^10.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
